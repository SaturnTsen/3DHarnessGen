{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Post-training: Preview (Single-view)",
            "type": "debugpy",
            "request": "launch",
            "module": "harness_training.cli",
            "python": "${workspaceFolder}/.pixi/envs/default/bin/python",
            "cwd": "${workspaceFolder}",
            "args": [
                "preview",
                "--config",
                "${workspaceFolder}/configs/sft_single_view.yaml",
                "--limit",
                "1",
                "--split",
                "train"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "stopOnEntry": true
        },
        {
            "name": "Post-training: Audit",
            "type": "debugpy",
            "request": "launch",
            "module": "harness_training.cli",
            "python": "${workspaceFolder}/.pixi/envs/default/bin/python",
            "cwd": "${workspaceFolder}",
            "args": [
                "audit",
                "--config",
                "${workspaceFolder}/configs/sft_single_view.yaml"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Remote Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 12888
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "."
                }
            ]
        }
    ]
}
